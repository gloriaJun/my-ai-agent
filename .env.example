# n8n
N8N_HOST=0.0.0.0
N8N_PATH=/
N8N_ENCRYPTION_KEY=some_random_key
WEBHOOK_URL=https://n8n.gloriajun.duckdns.org/
GENERIC_TIMEZONE=Asia/Seoul
N8N_WEBHOOK_BASE_URL=http://n8n:5678/webhook/my-ai-agent

# Ollama 연결 (서버 본체로 나가기 위한 주소)
OLLAMA_BASE_URL=http://host.docker.internal:11434

# OpenClaw 설정 (사용하시는 토큰이 있다면 입력)
BASE_PATH=/
PUBLIC_URL=https://gloriajun.duckdns.org
OPENCLAW_GATEWAY_TOKEN=5d3077...

SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=

# news-digest 연동 (t08). INGEST_TOKEN은 news-digest .env와 동일 값이어야 함.
NEWS_DIGEST_URL=http://news-digest:8080
INGEST_TOKEN=


## LLM
GEMINI_API_KEY=AIza...
BRAVE_API_KEY=xxxx

# LLM Provider Selection (switch provider by changing these two values)
LLM_PRIMARY_MODEL=codex/gpt-5.4-mini
LLM_FALLBACK_MODEL=codex/gpt-5.5

# Sub-LLM-Call backend (n8n -> OpenClaw gateway /v1/chat/completions).
# LLM_MODEL: backend model (x-openclaw-model header).
# LLM_AGENT: gateway agent route (body "model"). Flip to a lightweight
#            summarizer agent here without editing the n8n workflow.
LLM_MODEL=codex/gpt-5.4-mini
LLM_AGENT=openclaw/default


# OpenAI (uncomment OPENAI_API_KEY and update model vars above when switching)
# OPENAI_API_KEY=sk-...
