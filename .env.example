# n8n
N8N_HOST=0.0.0.0
N8N_PATH=/
N8N_ENCRYPTION_KEY=some_random_key
WEBHOOK_URL=https://gloriajun.duckdns.org:5678/
GENERIC_TIMEZONE=Asia/Seoul
N8N_WEBHOOK_BASE_URL=http://n8n:5678/webhook/my-ai-agent

# Ollama 연결 (서버 본체로 나가기 위한 주소)
OLLAMA_BASE_URL=http://host.docker.internal:11434

# OpenClaw 설정 (사용하시는 토큰이 있다면 입력)
OPENCLAW_BASE_PATH=/openclaw/
OPENCLAW_GATEWAY_TOKEN=5d3077...

SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=


## LLM
GEMINI_API_KEY=AIza...
BRAVE_API_KEY=xxxx

# LLM Provider Selection (switch provider by changing these two values)
LLM_PRIMARY_MODEL=google/gemini-2.5-flash
LLM_FALLBACK_MODEL=google/gemini-2.5-flash-lite


# OpenAI (uncomment OPENAI_API_KEY and update model vars above when switching)
# OPENAI_API_KEY=sk-...
